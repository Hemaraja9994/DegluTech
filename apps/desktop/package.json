{
  "name": "@laryngoos/desktop",
  "version": "1.0.0",
  "description": "DegluTech clinical workspace for speech-language pathology head and neck cancer rehabilitation.",
  "author": "Hemaraja Nayaka.S",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "corepack pnpm run build:web && corepack pnpm run build:electron",
    "build:web": "tsc --noEmit && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "lint": "tsc --noEmit",
    "deploy": "corepack pnpm dlx wrangler@latest pages deploy dist --project-name=deglutech --branch=main",
    "electron:start": "corepack pnpm run build && electron .",
    "electron:dev": "echo Start Vite in one terminal, then set ELECTRON_START_URL=http://localhost:3000 before launching electron in a second terminal.",
    "desktop:pack": "corepack pnpm run build && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --dir",
    "desktop:win": "corepack pnpm run build && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win nsis"
  },
  "dependencies": {
    "@laryngoos/core": "workspace:*",
    "@laryngoos/db": "workspace:*",
    "lucide-react": "^0.468.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^25.3.0",
    "electron-builder": "^24.6.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.1.6",
    "vite": "^4.4.5"
  },
  "build": {
    "appId": "in.deglutech.clinical",
    "productName": "DegluTech",
    "copyright": "Copyright © 2026 DegluTech",
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.ico",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "DegluTech-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DegluTech"
    }
  }
}
