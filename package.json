{
  "name": "dsrs-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test:clinical": "node --experimental-strip-types --test tests/clinical.test.ts tests/motion.test.ts tests/toolSuite.test.ts",
    "build:web": "corepack pnpm --filter @laryngoos/desktop run build:web",
    "deploy:web": "corepack pnpm run test:clinical && corepack pnpm run build:web && corepack pnpm --filter @laryngoos/desktop run deploy",
    "build": "corepack pnpm -r --if-present --sort run build",
    "dev": "corepack pnpm -r --parallel --if-present run dev",
    "lint": "corepack pnpm -r --if-present run lint",
    "clean": "corepack pnpm -r --if-present run clean",
    "desktop:pack": "corepack pnpm --filter @laryngoos/desktop run desktop:pack",
    "desktop:win": "corepack pnpm --filter @laryngoos/desktop run desktop:win"
  },
  "devDependencies": {
    "turbo": "^1.10.15",
    "typescript": "^5.1.6"
  }
}
